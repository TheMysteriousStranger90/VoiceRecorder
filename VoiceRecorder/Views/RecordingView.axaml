<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:VoiceRecorder.ViewModels"
             xmlns:controls="clr-namespace:VoiceRecorder.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="VoiceRecorder.Views.RecordingView"
             x:DataType="vm:RecordingViewModel">

    <StackPanel Margin="10">
        <controls:AudioVisualizerControl
            x:Name="AudioVisualizer"
            Height="100"
            Margin="0,10,0,0"
            IsActive="{Binding IsRecording}"
            AudioSamples="{Binding AudioSamples}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Command="{Binding StartRecordingCommand}"
                    Margin="0,10,10,0"
                    IsEnabled="{Binding !IsRecording}"
                    ToolTip.Tip="Start Recording">
                <Image Source="{SvgImage /Assets/play.svg}" Width="25" Height="25" />
            </Button>

            <Button Command="{Binding StopRecordingCommand}"
                    IsEnabled="{Binding IsRecording}"
                    Margin="10,10,0,0"
                    ToolTip.Tip="Stop Recording">
                <Image Source="{SvgImage /Assets/pause.svg}" Width="25" Height="25" />
            </Button>
        </StackPanel>

        <Grid ColumnDefinitions="*, 15, *" Margin="0,20,0,0">
            <StackPanel Grid.Column="0" Margin="10,0">
                <Label Content="FILTERS"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10" />

                <Border Background="#1A1A2E"
                        CornerRadius="8"
                        Padding="4"
                        MaxHeight="250">
                    <ScrollViewer>
                        <ListBox x:Name="FilterList"
                                 ItemsSource="{Binding AvailableFilters}"
                                 SelectedItem="{Binding SelectedFilterViewModel}"
                                 IsEnabled="{Binding !IsRecording}"
                                 Background="Transparent"
                                 BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,6" CornerRadius="4">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <Ellipse Grid.Column="0"
                                                     Width="8" Height="8"
                                                     Fill="#80F"
                                                     Margin="0,0,10,0"
                                                     VerticalAlignment="Center"
                                                     IsVisible="{Binding FilterStrategy, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontWeight="Medium"
                                                           Foreground="White" />
                                                <TextBlock Text="{Binding Description}"
                                                           Foreground="#888"
                                                           FontSize="10"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2" Margin="10,0">
                <Label Content="DEVICES"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10" />

                <Border Background="#1A1A2E"
                        CornerRadius="8"
                        Padding="4"
                        MaxHeight="250">
                    <ScrollViewer>
                        <ListBox x:Name="DeviceList"
                                 SelectedIndex="0"
                                 ItemsSource="{Binding AvailableDevices}"
                                 SelectedItem="{Binding SelectedDevice}"
                                 IsEnabled="{Binding !IsRecording}"
                                 ToolTip.Tip="{Binding DeviceTooltip}"
                                 Background="Transparent"
                                 BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,6" CornerRadius="4">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <Ellipse Grid.Column="0"
                                                     Width="8" Height="8"
                                                     Fill="#80F"
                                                     Margin="0,0,10,0"
                                                     VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding}"
                                                       FontWeight="Medium"
                                                       Foreground="White"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </Grid>

        <Button Command="{Binding OpenFolderCommand}"
                HorizontalAlignment="Center"
                Margin="0,25,0,0"
                ToolTip.Tip="Open Recordings Folder">
            <Image Source="{SvgImage /Assets/folder-plus.svg}" Width="25" Height="25" />
        </Button>

        <Label x:Name="TimerLabel"
               Content="{Binding TimerText}"
               HorizontalAlignment="Center"
               FontSize="24"
               Foreground="#80F"
               FontWeight="Bold"
               Margin="0,5,0,0" />
    </StackPanel>
</UserControl>
