<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:VoiceRecorder.ViewModels"
             xmlns:models="using:VoiceRecorder.Models"
             xmlns:enums="clr-namespace:VoiceRecorder.Models.Enums"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="800"
             x:Class="VoiceRecorder.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <Design.DataContext>
        <vm:SettingsViewModel />
    </Design.DataContext>

    <ScrollViewer>
        <StackPanel Margin="20" Spacing="20" MaxWidth="600">

            <!-- Header -->
            <TextBlock Text="Settings"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20" />

            <!-- Output Format Settings -->
            <Border Background="#303040"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="15">
                    <TextBlock Text="Output Format"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="White" />

                    <!-- Output Format -->
                    <StackPanel Spacing="5">
                        <TextBlock Text="File Format"
                                   Foreground="LightGray" />
                        <ComboBox ItemsSource="{Binding AvailableOutputFormats}"
                                  SelectedItem="{Binding OutputFormat}"
                                  HorizontalAlignment="Stretch"
                                  ToolTip.Tip="Output file format (WAV, MP3, AAC)" />
                    </StackPanel>

                    <!-- MP3 Bitrate (only visible when MP3 is selected) -->
                    <StackPanel Spacing="5"
                                IsVisible="{Binding OutputFormat, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static enums:OutputFormat.Mp3}}">
                        <TextBlock Text="MP3 Bitrate (kbps)"
                                   Foreground="LightGray" />
                        <ComboBox ItemsSource="{Binding AvailableMp3Bitrates}"
                                  SelectedItem="{Binding Mp3Bitrate}"
                                  HorizontalAlignment="Stretch"
                                  ToolTip.Tip="MP3 encoding bitrate" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Audio Format Settings -->
            <Border Background="#303040"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="15">
                    <TextBlock Text="Audio Format"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="White" />

                    <!-- Sample Rate -->
                    <StackPanel Spacing="5">
                        <TextBlock Text="Sample Rate (Hz)"
                                   Foreground="LightGray" />
                        <ComboBox ItemsSource="{Binding AvailableSampleRates}"
                                  SelectedItem="{Binding SampleRate}"
                                  HorizontalAlignment="Stretch"
                                  ToolTip.Tip="Audio sample rate in Hz (1-200 kHz)" />
                    </StackPanel>

                    <!-- Bits Per Sample -->
                    <StackPanel Spacing="5">
                        <TextBlock Text="Bits Per Sample"
                                   Foreground="LightGray" />
                        <ComboBox ItemsSource="{Binding AvailableBitsPerSample}"
                                  SelectedItem="{Binding BitsPerSample}"
                                  HorizontalAlignment="Stretch"
                                  ToolTip.Tip="Audio bit depth (8, 16, 24, or 32 bits)" />
                    </StackPanel>

                    <!-- Channels -->
                    <StackPanel Spacing="5">
                        <TextBlock Text="Channels"
                                   Foreground="LightGray" />
                        <ComboBox ItemsSource="{Binding AvailableChannels}"
                                  SelectedItem="{Binding Channels}"
                                  HorizontalAlignment="Stretch"
                                  ToolTip.Tip="Number of audio channels (1=Mono, 2=Stereo)" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Theme Settings -->
            <Border Background="#303040"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="15">
                    <TextBlock Text="Appearance"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="White" />

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <ToggleSwitch IsChecked="{Binding IsLightTheme}"
                                      ToolTip.Tip="Toggle between main and second theme" />
                        <TextBlock Text="Second Theme"
                                   VerticalAlignment="Center"
                                   Foreground="LightGray" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="10"
                        Margin="0,10,0,0">
                <Button Command="{Binding SaveSettingsCommand}"
                        Content="Save Settings"
                        Padding="20,10"
                        ToolTip.Tip="Save current settings" />

                <Button Command="{Binding ResetSettingsCommand}"
                        Content="Reset to Default"
                        Padding="20,10"
                        ToolTip.Tip="Reset all settings to default values" />
            </StackPanel>

            <!-- Filter Compatibility Info -->
            <Border Background="#303040"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="15">
                    <TextBlock Text="Audio Filters Compatibility"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="White" />

                    <TextBlock TextWrapping="Wrap"
                               Foreground="LightGray"
                               FontSize="12">
                        <Run Text="Audio filters use DMO effects which work best with:" />
                    </TextBlock>

                    <StackPanel Spacing="8" Margin="10,0,0,0">
                        <TextBlock Foreground="LightGray" FontSize="12">
                            <Run Text="• Bits Per Sample: " />
                            <Run Text="16-bit or 32-bit" FontWeight="SemiBold" Foreground="White" />
                        </TextBlock>
                        <TextBlock Foreground="LightGray" FontSize="12">
                            <Run Text="• Channels: " />
                            <Run Text="Stereo (2 channels)" FontWeight="SemiBold" Foreground="White" />
                        </TextBlock>
                        <TextBlock Foreground="LightGray" FontSize="12">
                            <Run Text="• Sample Rate: " />
                            <Run Text="44100 Hz or 48000 Hz" FontWeight="SemiBold" Foreground="White" />
                        </TextBlock>
                    </StackPanel>

                    <TextBlock TextWrapping="Wrap"
                               Foreground="Gray"
                               FontSize="11"
                               FontStyle="Italic"
                               Margin="0,5,0,0"
                               Text="Note: Using 8-bit or 24-bit with filters will automatically convert audio to 16-bit for processing, then back to your selected format." />
                    <StackPanel Spacing="10">
                        <TextBlock Text="Information"
                                   FontWeight="SemiBold"
                                   Foreground="White" />
                        <TextBlock TextWrapping="Wrap"
                                   Foreground="LightGray"
                                   FontSize="12">
                            <Run Text="• 44100 Hz is standard CD quality, 48000 Hz is video/broadcast standard" />
                            <LineBreak />
                            <Run Text="• 16-bit is recommended for most recordings" />
                            <LineBreak />
                            <Run Text="• Mono (1 channel) halves file size compared to Stereo" />
                            <LineBreak />
                            <Run Text="• Changes will apply to new recordings" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
